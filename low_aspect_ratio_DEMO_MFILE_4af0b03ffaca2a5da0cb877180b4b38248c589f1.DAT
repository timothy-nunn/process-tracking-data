i_bootstrap_current = 4
* DESCRIPTION:   Switch for Bootstrap Current Scaling
* JUSTIFICATION: Enforce Sauter scaling

i_beta_component = 1 
* DESCRIPTION:   Switch for beta limit scaling (icc=24)
